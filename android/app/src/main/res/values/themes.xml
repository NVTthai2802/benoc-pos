<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Benoc" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/cam</item>
        <item name="android:colorPrimaryDark">@color/cam_dam</item>
        <item name="android:colorAccent">@color/cam</item>
        <item name="android:statusBarColor">@color/cam_dam</item>
        <item name="android:windowBackground">@color/nen</item>
    </style>
    <style name="Theme.Benoc.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="Theme.Benoc.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/cam</item>
        <item name="android:colorPrimary">@color/cam</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
