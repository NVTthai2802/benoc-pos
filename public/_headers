# Header bảo mật cho Cloudflare Pages (GitHub Pages bỏ qua file này).
# - Không cho trang khác nhúng trang của quán vào khung (chống bấm lừa trên trang Quản lý).
#   Bếp / pha chế mở trang khác trong khung cùng địa chỉ nên vẫn chạy (SAMEORIGIN).
# - Bỏ Access-Control-Allow-Origin: * mà Cloudflare Pages tự thêm (trang của quán không cần cho web khác đọc).
# - Camera chỉ trang của quán dùng (chấm công, quét mã vạch). Bluetooth máy in không bị chặn.
# - CSP bật thật (11/2026): chỉ chạy JS của quán + thư viện QR / Excel trên cdnjs; không còn script nội tuyến,
#   font lưu ngay trên web của quán. Thêm dịch vụ ngoài mới thì phải thêm địa chỉ vào đây.
/*
  ! Access-Control-Allow-Origin
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.supabase.co; media-src 'self' blob:; connect-src 'self' blob: https://*.supabase.co wss://*.supabase.co https://world.openfoodfacts.org; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# App Android: tải về đúng loại file APK
/app/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="benoc-pos.apk"
  Cache-Control: no-cache

# Ảnh món và tiếng chuông ít khi đổi: cho trình duyệt giữ 7 ngày (hết hạn vẫn dùng bản cũ trong lúc tải bản mới)
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/sound/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# JS đã gắn mã băm trong tên tệp (Vite): nội dung đổi thì tên đổi, nên cho giữ 1 năm
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# PWA: service worker và mã bản build luôn lấy mới
/sw.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-store
